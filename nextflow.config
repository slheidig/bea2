/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    BioEnvAda v2 (bea2) — Nextflow configuration
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

manifest {
    name            = 'bea2'
    author          = 'Sophie-Luise Heidig'
    homePage        = 'https://github.com/Bio2Byte/bioenvada'
    description     = 'BioEnvAda v2: per-OG biophysical and evolutionary characterisation (mafft, b2bTools, AIUPred, IPC, IQ-TREE, csubst, HyPhy)'
    mainScript      = 'pipeline.nf'
    version         = '2.0.0'
    nextflowVersion = '!>=24.04.0'
}


params {
    // ---- inputs -------------------------------------------------------------
    aa_dir          = null            // folder of per-OG amino-acid fastas   <og>.fasta
    nuc_dir         = null            // folder of matching per-OG CDS fastas <og>.fasta
    categories      = null            // categories TSV (strain_name + category columns)
    category_column = 'temp_cat2'     // column of interest (header name or 1-based index)
    fg_level        = 'warm'          // value marking foreground lineages
    outgroup_level  = 'Outgroup'      // value marking rooting outgroup
    og_pattern      = 'CK_\\d+'       // regex recognising an OG id inside identifiers (e.g. 'OG\\d+')
    predictions_csv = null            // big custom-predictions table (block_id,residue_index,aa,pred_*)
    structure_dir   = null            // predicted models: <structure_dir>/<og>/<sequence_id>.pdb

    // ---- MSA ---------------------------------------------------------------
    occupancy       = 0.5             // min column occupancy kept in the pruned MSA
    genetic_code    = 11              // NCBI genetic code (11 = bacterial)

    // ---- tool toggles --------------------------------------------------------
    b2btools        = true
    aiupred         = true
    ipc             = true
    dssp            = false           // needs --structure_dir
    csubst          = true
    hyphy           = true

    // ---- predictor options ----------------------------------------------------
    b2btools_tools  = 'dynamine,efoldmine,disomine,agmata'
    aiupred_binding = true            // also predict binding (one AIUPred pass gives both)
    ipc_ph          = 7.0
    ipc_pka_set     = 'IPC_protein'
    ss_consensus    = 0.5             // min frequency for a consensus H/E in the DSSP plots

    // ---- tree -----------------------------------------------------------------
    iqtree_model    = 'ECMK07+F+R4'
    ufboot          = 1000

    // ---- csubst ----------------------------------------------------------------
    ocn_cutoff        = 0.5           // min OCNany2{spe,dif} for a significant pair/site
    omega_cutoff      = 1.0           // min omegaCany2{spe,dif}
    csubst_site_plots = true
    csubst_plot_format = 'pdf'

    // ---- hyphy -----------------------------------------------------------------
    hyphy_methods    = 'FEL,FUBAR,MEME'          // whole-tree per-site methods
    hyphy_fg_methods = 'contrast-fel,relax'      // foreground methods
    hyphy_code       = 'Universal'    // NCBI 11 differs from Universal only in START codons
    hyphy_branches   = 'All'
    pvalue           = 0.1
    posterior        = 0.9

    // ---- output -----------------------------------------------------------------
    outdir           = 'results'
    apptainercache   = '.apptainer'   // override with --apptainercache <dir>
}

// ---- containers (docker; converted to singularity/apptainer on the clusters) ----
process {


    // csubst image: csubst + cdskit + IQ-TREE 3 + python/ete4
    withName: 'BACKALIGN|PRUNE_MSA|MAKE_FOREGROUND|MAKE_CONSTRAINT|IQTREE|ROOT_TREE|CSUBST' {
        container = 'slheidig/csubst:01'
    }
    withName: 'ALIGN_AA' {
        container = 'quay.io/biocontainers/mafft:7.520--h031d066_3'
    }
    withName: 'HYPHY_WHOLETREE|HYPHY_FOREGROUND' {
        container = 'slheidig/hyphy:2.5.101'        // build from docker/hyphy/
    }
    withName: 'AIUPRED' {
        // official CPU image from the AIUPred authors (see github.com/doszilab/AIUPred-NF).
        // Nothing to build; amd64-only, which is what the clusters need.
        container = 'ghcr.io/doszilab/aiupred:cpu'
    }
    withName: 'IPC' {
        container = 'slheidig/ipc:01'               // build from docker/ipc/
    }
    withName: 'DSSP_RUN' {
        container = 'slheidig/dssp3:2'              // mkdssp 3, same image simsapiper uses
    }
    // secstructartist lives in the simsapiper image; nothing to build
    withName: 'PLOT_DSSP' {
        container = 'slheidig/simsapiper:06'
    }
    // b2bTools image also carries pandas/matplotlib for all table/plot steps
    withName: 'B2BTOOLS|DSSP_PARSE|HYPHY_BYSITE|MAP_TO_MSA|COMBINE_TABLE|PLOT_OG|GLOBAL_STATS|SPLIT_CUSTOM_PREDICTIONS' {
        container = 'slheidig/og_b2b_pca:latest'
    }
}

// ---- base resources (scaled by retry attempt; one bad OG never kills the run) ----
process {
    cpus   = { 2    * task.attempt }
    memory = { 4.GB * task.attempt }
    time   = { 1.h   * task.attempt }

    errorStrategy = { task.attempt <= 1 ? 'retry' : 'ignore' }


    withLabel: small {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 10.min  * task.attempt }
    }
    withLabel: medium {
        cpus   = { 2    * task.attempt }
        memory = { 4.GB * task.attempt }
        time   = { 1.h  * task.attempt }
    }
    withLabel: large {
        cpus   = { 4    * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = { 1.h  * task.attempt }
    }
    withLabel: highmem_single {
        cpus   = { 4     * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 1.h   * task.attempt }
    }
}

env {
    PYTHONNOUSERSITE = 1
}


process.shell = ['/bin/bash', '-euo', 'pipefail']
nextflow.enable.configProcessNamesValidation = false

profiles {
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        apptainer.cacheDir   = "${params.apptainercache}"
    }
    hydra {
        includeConfig 'conf/hydra.config'
    }
    hpc {
        includeConfig 'conf/hpc.config'
    }
    local {
        docker.enabled = true
        docker.temp    = 'auto'
        process.executor = 'local'
        executor.cpus    = 8
    }
    test {
        params.occupancy = 0.5
        params.ufboot    = 1000
        process.executor = 'local'
        executor.cpus    = 4
    }
}
