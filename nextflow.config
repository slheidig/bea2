/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    BioEnvAda v2 (bea2) — Nextflow configuration

    One file, one block per process. There are no `label`s and no conf/ any
    more: everything a process gets is on the lines that name it.

    WHY NO LABELS
    A `withLabel:`/`withName:` block does NOT merge with a same-named block
    defined elsewhere -- the later definition REPLACES it wholesale. With
    resources on a label in one file and `array`/`executor` on the same label in
    another, every cpus/memory/time setting was silently dropped and IQ-TREE ran
    1000 bootstraps on 2 cpus / 4 GB. Per-process blocks make that impossible.

    EXECUTION MODEL
    The default is the LOCAL executor: the task runs inside the driver's own
    allocation. That is right for the short steps (seconds each, ~8 per OG) --
    a Slurm round-trip costs more than the work. The nine processes under
    "SLURM" below ask for a real job; nothing else is ever submitted.

    Set --array_size 0 to switch off job-array batching, or --heavy_executor
    local to run even the heavy steps inside the driver allocation.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

manifest {
    name            = 'bea2'
    author          = 'Sophie-Luise Heidig'
    homePage        = 'https://github.com/Bio2Byte/bioenvada'
    description     = 'BioEnvAda v2: per-OG biophysical and evolutionary characterisation (mafft, b2bTools, AIUPred, IPC, IQ-TREE, csubst, HyPhy)'
    mainScript      = 'pipeline.nf'
    version         = '2.0.0'
    nextflowVersion = '!>=24.04.0'
}

params {
    // ---- inputs -------------------------------------------------------------
    aa_dir          = null            // folder of per-OG amino-acid fastas   <og>.fasta
    nuc_dir         = null            // folder of matching per-OG CDS fastas <og>.fasta
    categories      = null            // categories TSV (strain_name + category columns)
    category_column = 'temp_cat2'     // column of interest (header name or 1-based index)
    fg_level        = 'warm'          // value marking foreground lineages
    outgroup_level  = 'Outgroup'      // value marking rooting outgroup
    og_pattern      = 'CK_\\d+'       // regex recognising an OG id inside identifiers
    predictions_csv = null            // big custom-predictions table
    structure_dir   = null            // predicted models: <structure_dir>/<og>/<sequence_id>.pdb

    // ---- MSA ---------------------------------------------------------------
    occupancy       = 0.5             // min column occupancy kept in the pruned MSA
    genetic_code    = 11              // NCBI genetic code (11 = bacterial)

    // ---- tool toggles --------------------------------------------------------
    b2btools        = true
    aiupred         = true
    ipc             = true
    dssp            = false           // needs --structure_dir
    csubst          = true
    hyphy           = true

    // ---- predictor options ----------------------------------------------------
    b2btools_tools  = 'dynamine,efoldmine,disomine,agmata'
    aiupred_binding = true            // also predict binding (one AIUPred pass gives both)
    ipc_ph          = 7.0
    ipc_pka_set     = 'IPC_protein'
    ss_consensus    = 0.5             // min frequency for a consensus H/E in the DSSP plots

    // ---- tree -----------------------------------------------------------------
    iqtree_model    = 'ECMK07+F+R4'
    ufboot          = 1000

    // ---- csubst ----------------------------------------------------------------
    ocn_cutoff        = 0.5           // min OCNany2{spe,dif} for a significant pair/site
    omega_cutoff      = 1.0           // min omegaCany2{spe,dif}
    csubst_site_plots = false         // regenerate per-pair figures with ./replot_og.sh
    csubst_plot_format = 'pdf'
    publish_csubst_native = false     // also publish inspect/ and csubst's csubst_iqtree/

    // ---- hyphy -----------------------------------------------------------------
    hyphy_methods    = 'FEL,FUBAR,MEME'          // whole-tree per-site methods
    hyphy_fg_methods = 'contrast-fel,relax'      // foreground methods
    hyphy_code       = 'Universal'    // NCBI 11 differs from Universal only in START codons
    hyphy_branches   = 'All'
    pvalue           = 0.1
    posterior        = 0.9

    // ---- output -----------------------------------------------------------------
    outdir           = 'results'
    apptainercache   = '.apptainer'   // override with --apptainercache <dir>
    plot             = 'all'          // 'all' | 'none' | 'CK_00000105,CK_00001561'

    // ---- scheduling -------------------------------------------------------------
    heavy_executor   = 'slurm'        // 'local' to run everything in one allocation
    array_size       = 50             // Slurm job-array batch size; 0 disables batching
    slurm_account    = null           // hpc profile only
    slurm_queue      = null           // hpc profile only
}

process {
    /* ---- defaults: local execution inside the driver's own allocation ---- */
    executor = 'local'
    cpus     = 1
    memory   = { 2.GB   * task.attempt }
    time     = { 10.min * task.attempt }

    // Retry once, then ignore -- for EVERY process, no exceptions. Individual
    // protein families are expected to fail; that is never a reason to end the
    // run. Do not override this per process.
    errorStrategy = { task.attempt <= 1 ? 'retry' : 'ignore' }

    /* =====================================================================
       LOCAL — seconds each, run in the driver allocation, never submitted.
       Container only; resources come from the defaults above.
       ===================================================================== */
    withName: 'ALIGN_AA'    { container = 'quay.io/biocontainers/mafft:7.520--h031d066_3' }
    withName: 'PRUNE'       { container = 'slheidig/csubst:01' }        // stdlib python
    withName: 'MAKE_FOREGROUND' { container = 'slheidig/csubst:01' }    // stdlib python
    withName: 'MAP_TO_MSA'  { container = 'slheidig/og_b2b_pca:latest' }// stdlib python
    withName: 'IPC'         { container = 'slheidig/ipc:01' }
    withName: 'DSSP'        { container = 'slheidig/dssp3:2' }          // mkdssp + python3
    withName: 'PLOT_OG'     { container = 'slheidig/og_b2b_pca:latest' }
    withName: 'PLOT_DSSP'   { container = 'slheidig/simsapiper:06' }    // secstructartist

    /* =====================================================================
       SLURM — the nine processes worth a job of their own. Each block is
       complete: executor, batching, resources, container, error handling.
       ===================================================================== */
    // 30 min, not the measured 2x (13 min): larger OGs carry many more residues
    withName: 'B2BTOOLS' {
        executor  = params.heavy_executor
        array     = params.array_size > 1 ? params.array_size : null
        cpus      = { 2      * task.attempt }
        memory    = { 4.GB   * task.attempt }   // peak 1000 MB
        time      = { 30.min * task.attempt }   // max 377 s
        container = 'slheidig/og_b2b_pca:latest'
    }
    withName: 'COLLECT' {
        executor  = params.heavy_executor
        array     = params.array_size > 1 ? params.array_size : null
        cpus      = { 2      * task.attempt }
        memory    = { 2.GB   * task.attempt }   // peak 232 MB
        time      = { 10.min * task.attempt }   // max 15 s
        container = 'slheidig/og_b2b_pca:latest'
    }
    withName: 'AIUPRED' {
        executor  = params.heavy_executor
        array     = params.array_size > 1 ? params.array_size : null
        cpus      = { 4      * task.attempt }
        memory    = { 4.GB   * task.attempt }   // peak 1964 MB - the memory hog
        time      = { 15.min * task.attempt }   // max 55 s
        container = 'ghcr.io/doszilab/aiupred:cpu'
    }
    withName: 'HYPHY_WHOLETREE' {
        executor  = params.heavy_executor
        array     = params.array_size > 1 ? params.array_size : null
        cpus      = { 4      * task.attempt }
        memory    = { 2.GB   * task.attempt }   // peak 172 MB
        time      = { 30.min * task.attempt }   // max 735 s
        container = 'slheidig/hyphy:2.5.101'
    }
    withName: 'HYPHY_FOREGROUND' {
        executor  = params.heavy_executor
        array     = params.array_size > 1 ? params.array_size : null
        cpus      = { 4      * task.attempt }
        memory    = { 2.GB   * task.attempt }   // peak 278 MB
        time      = { 30.min * task.attempt }   // max 397 s
        container = 'slheidig/hyphy:2.5.101'
    }
    // These two are the only processes whose cost scales with the NUMBER of OGs
    // rather than with one family, so the 8-OG measurements below say nothing
    // about a 1500-family run: both are deliberately over-provisioned.
    withName: 'SPLIT_CUSTOM_PREDICTIONS' {
        executor  = params.heavy_executor
        cpus      = { 4      * task.attempt }
        memory    = { 8.GB   * task.attempt }   // peak 2921 MB on the test CSV
        time      = { 30.min * task.attempt }   // max 137 s
        container = 'slheidig/og_b2b_pca:latest'
    }
    withName: 'GLOBAL_STATS' {
        executor  = params.heavy_executor
        cpus      = { 4     * task.attempt }
        memory    = { 16.GB * task.attempt }    // peak 475 MB over 8 OGs
        time      = { 1.h   * task.attempt }    // max 13 s over 8 OGs
        container = 'slheidig/og_b2b_pca:latest'
    }
    withName: 'TREE' {
        executor  = params.heavy_executor
        array     = params.array_size > 1 ? params.array_size : null
        cpus      = { 4    * task.attempt }
        memory    = { 4.GB * task.attempt }    // peak 238 MB
        time      = { 1.h  * task.attempt }    // max 1294 s on 4 cpus
        container = 'slheidig/csubst:01'                      // iqtree3 + ete4
    }
    // 30 min, not the measured 2x (3 min): csubst's runtime grows with the
    // number of significant branch pairs, which the test families barely have.
    withName: 'CSUBST' {
        executor  = params.heavy_executor
        array     = params.array_size > 1 ? params.array_size : null
        cpus      = { 4      * task.attempt }
        memory    = { 4.GB   * task.attempt }  // peak 472 MB
        time      = { 30.min * task.attempt }  // max 97 s
        container = 'slheidig/csubst:01'
    }
}

env {
    PYTHONNOUSERSITE = 1
}

process.shell = ['/bin/bash', '-euo', 'pipefail']
nextflow.enable.configProcessNamesValidation = false

profiles {

    /* ===================== VUB Hydra: apptainer + modules ===================== */
    // Overrides only the LOCAL processes above, swapping their container for
    // host software. Those blocks hold nothing but a container, so replacing
    // them loses nothing. The SLURM blocks are untouched.
    hydra {
        apptainer {
            enabled    = true
            autoMounts = true
            cacheDir   = params.apptainercache
        }

        executor {
            queueSize         = 300
            submitRateLimit   = '30/1min'
            pollInterval      = '30 sec'
            queueStatInterval = '2 min'
            dumpInterval      = '5 min'
            exitReadTimeout   = '5 min'
        }

        process {
            // node-local scratch: tool intermediates never reach the shared FS,
            // only declared outputs are copied back
            scratch = true
            // clusterOptions = '--mail-type=FAIL'

            // The micromamba images (csubst, hyphy) keep their CLIs in
            // /opt/conda/bin behind an ENTRYPOINT that Nextflow skips, so tasks
            // would die with exit 127. beforeScript cannot fix it: apptainer
            // REPLACES PATH inside the container, and APPTAINERENV_PREPEND_PATH
            // is wiped because Nextflow launches with `env - PATH="$PATH" ...
            // apptainer exec` (see nxf_launch in any .command.run). Only
            // --env PREPEND_PATH on the apptainer command line survives.
            // Global, so it never has to appear inside a withName block.
            containerOptions = '--env PREPEND_PATH=/opt/conda/bin'

            // covers the pandas/matplotlib scripts that run without a container
            module = 'SciPy-bundle:matplotlib'

            // <- adjust to what `module av` shows on Hydra
            withName: 'ALIGN_AA'        { container = null; module = 'MAFFT/7.526-GCC-14.2.0-with-extensions' }
            withName: 'MAKE_FOREGROUND' { container = null }   // stdlib only
            withName: 'PRUNE'           { container = null }   // stdlib only
            withName: 'MAP_TO_MSA'      { container = null }   // stdlib only
            withName: 'PLOT_OG'         { container = null }   // module matplotlib/pandas
        }
    }

    /* ============ Any cluster: Slurm + containers, no host software ============ */
    // Overrides no process at all -- every container is declared above, so this
    // profile only has to turn singularity on.
    hpc {
        singularity {
            enabled    = true
            autoMounts = true
            cacheDir   = (System.getenv('NXF_SINGULARITY_CACHEDIR') ?: './.apptainer')
        }

        executor {
            queueSize         = 300
            submitRateLimit   = '30/1min'
            pollInterval      = '30 sec'
            queueStatInterval = '2 min'
        }

        process {
            scratch          = true
            queue            = params.slurm_queue
            clusterOptions   = params.slurm_account ? "--account=${params.slurm_account}" : null
            containerOptions = '--env PREPEND_PATH=/opt/conda/bin'
        }
    }

    /* ================= Local (laptop): docker, nothing submitted ================= */
    local {
        docker.enabled       = true
        docker.temp          = 'auto'
        params.heavy_executor = 'local'
        params.array_size     = 0
    }

}
