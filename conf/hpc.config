/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Generic HPC profile — Slurm + Singularity/Apptainer containers for
    EVERYTHING (no modules, no host assumptions).

    Optionally set on the command line or in a local override:
        --slurm_account myaccount   --slurm_queue mypartition
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params.slurm_account = null
params.slurm_queue   = null

singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = (System.getenv('NXF_SINGULARITY_CACHEDIR') ?: './.apptainer')
}

executor {
    queueSize       = 100
    submitRateLimit = '10 sec'
}

process {
    executor = 'slurm'
    queue    = params.slurm_queue
    clusterOptions = params.slurm_account ? "--account=${params.slurm_account}" : null

    // ---- micromamba images: base env is not on PATH (see conf/hydra.config) ----
    // Same fix as on hydra, plus IQTREE: this profile runs everything in
    // containers, so IQTREE uses the csubst image here instead of a module.
    withName: 'BACKALIGN|PRUNE_MSA|MAKE_FOREGROUND|MAKE_CONSTRAINT|IQTREE|ROOT_TREE|CSUBST|HYPHY_WHOLETREE|HYPHY_FOREGROUND' {
        containerOptions = '--env PREPEND_PATH=/opt/conda/bin'
    }
}
