/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Hydra (VUB HPC) profile — Slurm + environment modules for the basic tools
    (MAFFT, IQ-TREE) + Singularity/Apptainer containers for everything else.

    Scheduling at proteome scale (~1500 OGs):
      - 'small' tasks run on the LOCAL executor, i.e. inside the driver's own
        allocation. They take 5-20 s each, so a Slurm round-trip costs more than
        the work; run_test.sh must therefore request enough cpus/mem for them.
      - everything heavier is submitted as Slurm JOB ARRAYS, so ~25k tasks become
        a few hundred sbatch calls instead of one each.
      - process.scratch keeps tool intermediates on node-local disk; only the
        declared outputs are copied back to the shared work dir.

    !! Set the exact module strings below to what `module av` shows on Hydra.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

apptainer {
    enabled    = true
    autoMounts = true
    cacheDir   = params.apptainercache
}

executor {
    queueSize         = 300
    submitRateLimit   = '30/1min'
    pollInterval      = '30 sec'
    queueStatInterval = '2 min'
    dumpInterval      = '5 min'
    exitReadTimeout   = '5 min'
    // local-executor budget: must fit inside the driver job's own allocation
    cpus              = 16
    memory            = '48 GB'
}

process {
    executor = 'slurm'
    scratch  = true        // switch to '$VSC_SCRATCH_NODE' if TMPDIR is not node-local
    // clusterOptions = '--mail-type=FAIL'

    withLabel: large          { array = 50 }
    withLabel: medium         { array = 50 }
    withLabel: highmem_single { array = 25 }

    // seconds-long tasks: run them in the driver allocation, never via Slurm
    withLabel: small {
        executor = 'local'
        scratch  = false
    }

    // ---- modules instead of containers for the basic dependencies ----

    module    = 'SciPy-bundle:matplotlib'

    withName: 'ALIGN_AA' {
        container = null
        module    = 'MAFFT/7.526-GCC-14.2.0-with-extensions'   // <- adjust to Hydra
    }

    // Stdlib-only helpers (verified: argparse/csv/os/re/math only) need no
    // container at all, and the pandas/matplotlib ones are covered by the
    // module default above. Skipping apptainer here removes ~6 s of container
    // startup per task and a lot of shared-filesystem metadata traffic.
    withName: 'MAKE_FOREGROUND|PRUNE|MAP_TO_MSA|COLLECT|PLOT_OG|GLOBAL_STATS' {
        container = null
    }

    // ---- micromamba images: base env is not on PATH ----
    // The csubst and hyphy images (FROM mambaorg/micromamba) keep
    // python3/csubst/cdskit/iqtree3/hyphy in /opt/conda/bin and rely on their
    // ENTRYPOINT to activate them. Nextflow skips the entrypoint, so those CLIs
    // are invisible and every task dies with exit 127.
    //
    // Extending PATH in beforeScript does NOT work: apptainer REPLACES PATH
    // inside the container with its own default, so the host value never
    // arrives. Nor can we export APPTAINERENV_PREPEND_PATH, because Nextflow
    // launches with `env - PATH="$PATH" ... apptainer exec ...` (see nxf_launch
    // in any .command.run) and `env -` wipes it.
    //
    // What does work is putting it on the apptainer command line itself:
    // --env PREPEND_PATH is honoured by apptainer/singularity >= 3.6. Nextflow
    // appends its own bin/ to PATH afterwards (nxf_container_env), so the
    // pipeline's bin/*.py scripts still resolve.
    withName: 'TREE|CSUBST|HYPHY_WHOLETREE|HYPHY_FOREGROUND' {
        containerOptions = '--env PREPEND_PATH=/opt/conda/bin'
    }
}

//env {
//    APPTAINER_CACHEDIR = (System.getenv('VSC_SCRATCH') ?: './') + '/.apptainer'
//}
