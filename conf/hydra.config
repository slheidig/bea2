/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Hydra (VUB HPC) profile — Slurm + environment modules for the basic tools
    (MAFFT, IQ-TREE) + Singularity/Apptainer containers for everything else.

    !! Set the exact module strings below to what `module av` shows on Hydra.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

apptainer {
    enabled    = true
    autoMounts = true
    cacheDir   = params.apptainercache
}

executor {
    queueSize       = 100
    submitRateLimit = '10 sec'
}

process {
    executor = 'slurm'
    // clusterOptions = '--mail-type=FAIL'

    // ---- modules instead of containers for the basic dependencies ----
    withName: 'ALIGN_AA' {
        container = null
        module    = 'MAFFT/7.526-GCC-14.2.0-with-extensions'   // <- adjust to Hydra
    }
    withName: 'IQTREE' {
        container = null
        module    = 'IQ-TREE/2.4.0-gompi-2024a'              // <- adjust to Hydra
    }
}

//env {
//    APPTAINER_CACHEDIR = (System.getenv('VSC_SCRATCH') ?: './') + '/.apptainer'
//}
