/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Hydra (VUB HPC) profile — Slurm + environment modules for the basic tools
    (MAFFT, IQ-TREE) + Singularity/Apptainer containers for everything else.

    !! Set the exact module strings below to what `module av` shows on Hydra.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

apptainer {
    enabled    = true
    autoMounts = true
    cacheDir   = params.apptainercache
}

executor {
    queueSize       = 100
    submitRateLimit = '10 sec'
}

process {
    executor = 'slurm'
    // clusterOptions = '--mail-type=FAIL'

    // ---- modules instead of containers for the basic dependencies ----

    module    = 'SciPy-bundle:matplotlib' 
    withName: 'MAKE_FOREGROUND|MAKE_CONSTRAINT' {
        container = null
        module    = 'SciPy-bundle'   // <- adjust to Hydra
    }

    withName: 'ALIGN_AA' {
        container = null
        module    = 'MAFFT/7.526-GCC-14.2.0-with-extensions'   // <- adjust to Hydra
    }
    withName: 'IQTREE' {
        container = null
        module    = 'IQ-TREE/2.4.0-gompi-2024a'              // <- adjust to Hydra
    }

    // ---- micromamba images: base env is not on PATH ----
    // The csubst and hyphy images (FROM mambaorg/micromamba) keep
    // python3/csubst/cdskit/iqtree3/hyphy in /opt/conda/bin and rely on their
    // ENTRYPOINT to activate them. Nextflow skips the entrypoint, so those CLIs
    // are invisible and every task dies with exit 127.
    //
    // Extending PATH in beforeScript does NOT work: apptainer REPLACES PATH
    // inside the container with its own default, so the host value never
    // arrives. Nor can we export APPTAINERENV_PREPEND_PATH, because Nextflow
    // launches with `env - PATH="$PATH" ... apptainer exec ...` (see nxf_launch
    // in any .command.run) and `env -` wipes it.
    //
    // What does work is putting it on the apptainer command line itself:
    // --env PREPEND_PATH is honoured by apptainer/singularity >= 3.6. Nextflow
    // appends its own bin/ to PATH afterwards (nxf_container_env), so the
    // pipeline's bin/*.py scripts still resolve.
    withName: 'BACKALIGN|PRUNE_MSA|MAKE_FOREGROUND|MAKE_CONSTRAINT|ROOT_TREE|CSUBST|HYPHY_WHOLETREE|HYPHY_FOREGROUND' {
        containerOptions = '--env PREPEND_PATH=/opt/conda/bin'
    }
}

//env {
//    APPTAINER_CACHEDIR = (System.getenv('VSC_SCRATCH') ?: './') + '/.apptainer'
//}
