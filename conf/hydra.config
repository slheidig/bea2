/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Hydra (VUB HPC) profile — Slurm + environment modules for the basic tools
    (MAFFT, IQ-TREE) + Singularity/Apptainer containers for everything else.

    !! Set the exact module strings below to what `module av` shows on Hydra.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

apptainer {
    enabled    = true
    autoMounts = true
    cacheDir   = params.apptainercache
}

executor {
    queueSize       = 100
    submitRateLimit = '10 sec'
}

process {
    executor = 'slurm'
    // clusterOptions = '--mail-type=FAIL'

    // ---- modules instead of containers for the basic dependencies ----
    withName: 'ALIGN_AA' {
        container = null
        module    = 'MAFFT/7.526-GCC-14.2.0-with-extensions'   // <- adjust to Hydra
    }
    withName: 'IQTREE' {
        container = null
        module    = 'IQ-TREE/2.4.0-gompi-2024a'              // <- adjust to Hydra
    }

    // ---- csubst image only: micromamba base env is not on PATH ----
    // That image (docker/csubst/Dockerfile, FROM mambaorg/micromamba) keeps
    // python/csubst/cdskit/iqtree3 in /opt/conda/bin and relies on its
    // ENTRYPOINT to activate them. Nextflow skips the entrypoint and Apptainer
    // replaces the image PATH with the host's, so `env python3` fails (exit
    // 127). PREPEND_PATH restores it without clobbering Nextflow's bin/ entry.
    withName: 'BACKALIGN|PRUNE_MSA|MAKE_FOREGROUND|MAKE_CONSTRAINT|ROOT_TREE|CSUBST' {
        beforeScript = 'export APPTAINERENV_PREPEND_PATH=/opt/conda/bin'
    }
}

//env {
//    APPTAINER_CACHEDIR = (System.getenv('VSC_SCRATCH') ?: './') + '/.apptainer'
//}
